							<tr>
								<td scope="col"><span class="titlehead"><button type="button" class="btn btn-light btn-sm" id="prev-year">&lt;</button></span></td>
								<td scope="col"><span class="titletext" id="week-display">&nbsp;<%=revenues.yearDisplay%>&nbsp;</span></td>
