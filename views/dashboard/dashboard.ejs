				<div class="col-sm-4">
					<div class="chartbox">
						<p>Monthly Revenue Comparison</p>
						<table>
							<tr>
								<td scope="col"><span class="titlehead"><button type="button" class="btn btn-light btn-sm" id="prev-month">&lt;</button></span></td>
								<td scope="col"><span class="titletext" id="month-display">&nbsp;<%=revenues.monthDisplay%>&nbsp;</span></td>
