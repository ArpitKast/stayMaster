<script>
document.addEventListener('DOMContentLoaded', function () {
	const dashboardForm = document.getElementById('dashboardForm');
	const monthDisplay = document.getElementById('month-display');
    const weekStart = document.getElementById?.('week-start');
	const monthStart = document.getElementById('month-start');
	const yearStart = document.getElementById('year-start');
	const weekly = document.getElementById('weeklyChart').getContext('2d');
	const weekChart = makeChart(weekly);
	const monthly = document.getElementById('monthlyChart').getContext('2d');
	const monthChart = makeChart(monthly);
	const yearly = document.getElementById('annualChart').getContext('2d');
	const yearChart = makeChart(yearly);
	const propertyPie = document.getElementById('propertyPie').getContext('2d');
	const propertyChart = makePie(propertyPie);
	const channelPie = document.getElementById('channelPie').getContext('2d');
	const channelChart = makePie(channelPie);
	const typePie = document.getElementById('typePie').getContext('2d');
	const typeChart = makePie(typePie);

	initializeCharts();
		
	function initializeCharts(){
		updateChart(weekChart,<%- JSON.stringify(revenues.weeklyData) %>);
		updateChart(monthChart,<%- JSON.stringify(revenues.monthlyData) %>);
		updateChart(yearChart,<%- JSON.stringify(revenues.yearlyData) %>);
		updatePieChart(propertyChart,<%- JSON.stringify(props) %>);
		updatePieChart(channelChart,<%- JSON.stringify(channels) %>);
		updatePieChart(typeChart,<%- JSON.stringify(propTypes) %>);
	}

	document.getElementById('prev-week').addEventListener('click', async() => {
		const response = await getChartData('week','prev',weekStart?.value);
		updateChart(weekChart,response);
		weekStart.value = response?.start;
		document.getElementById('week-display').innerText = response.display;
		console.log(response);
    });
	document.getElementById('prev-month').addEventListener('click', async() => {
		const response = await getChartData('month','prev',monthStart.value);
		updateChart(monthChart,response);
		monthStart.value = response.start;
		document.getElementById('month-display').innerText = response.display;
    });
	document.getElementById('prev-year').addEventListener('click', async() => {
		const response = await getChartData('year','prev',yearStart.value);
		updateChart(yearChart,response);
		yearStart.value = response.start;
		document.getElementById('year-display').innerText = response.display;
    });
	document.getElementById('next-week').addEventListener('click', async() => {
		const response = await getChartData('week','next',weekStart?.value);
		console.log(response);
		updateChart(weekChart,response);
		weekStart.value = response?.start;
		document.getElementById('week-display').innerText = response.display;
    });
	document.getElementById('next-month').addEventListener('click', async() => {
		const response = await getChartData('month','next',monthStart.value);
		updateChart(monthChart,response);
		monthStart.value = response.start;
		document.getElementById('month-display').innerText = response.display;
    });
	document.getElementById('next-year').addEventListener('click', async() => {
		const response = await getChartData('year','next',yearStart.value);
		updateChart(yearChart,response);
		yearStart.value = response.start;
		document.getElementById('year-display').innerText = response.display;
    });

	function makePie(ctxPie){
		return new Chart(ctxPie, {
			type: 'doughnut',
			data: {
				labels: [], // Categories
				datasets: [{
				data: [], // Values
				backgroundColor: [
					/*'rgba(255, 99, 132, 0.7)', // Colors for each category
					'rgba(54, 162, 235, 0.7)',
					'rgba(255, 206, 86, 0.7)',*/
				],
				borderColor: [
					/*'rgba(255, 99, 132, 1)',
					'rgba(54, 162, 235, 1)',
					'rgba(255, 206, 86, 1)',*/
				],
				borderWidth: 1
				}]
			},
			options: {
				responsive: true,
				plugins: {
				legend: {
					display: true,
					position: 'left',
				},
				tooltip: {
					enabled: true,
				}
				}
			}
		});
	}

	function makeChart(ctx){
		return new Chart(ctx, {
			type: 'line',
			data: {
				labels: [],
				datasets: [{
					label: 'Revenue',
					data: [],
					borderColor: '#048183',//#048183 4,129,31
					borderWidth: 1,
					tension: 0.1,
					backgroundColor: 'rgba(4,129,131,0.2)', // Fill color  '#9FC0AF'
      				fill: true,
				},{
					label: 'Prev',
					data: [],
					borderColor: '#C1B483',
					borderWidth: 1,
					tension: 0.1,
					backgroundColor: 'rgba(225,217,194,0.8)',//
					fill: true
				},]
			},
			options: {
				responsive: true,
				plugins: {
					legend: {
						display: false,
					},
				},
				scales: {
					x: {
						title: { display: false, text: 'Date' }
					},
					y: {
						title: { display: false, text: 'Revenue' },
						beginAtZero: true
					}
				}
			}
    	});
	}

	function updatePieChart(pieChart,data) {
		const labels = data.map(item => item.category);
		const values = data.map(item => item.count);

		const backgroundColors = labels.map(() => generateRandomColor());
    	const borderColors = labels.map(() => generateRandomBorderColor());

		pieChart.data.labels = labels;
		pieChart.data.datasets[0].data = values;
		pieChart.data.datasets[0].backgroundColor = backgroundColors;
    	pieChart.data.datasets[0].borderColor = borderColors;
		pieChart.update();
	}

	async function getChartData(duration,range,startDate){
		try {
                const formData = new FormData(dashboardForm);
				formData.append('duration', duration);
				formData.append('range', range);
				formData.append('startDate',startDate);
                console.log(formData);
                // Send formData to backend
                const response = await fetch('/admin/chart', {
                    method: 'POST',
                    body: formData,
                });

                if (!response.ok) {
                    console.log('Failed to save user:', response.json());
                    throw new Error('Failed to save user');
                }

                const result = await response.json();
                if(result.success){
					return result.data;
                }else{
                    alert(result.error);
                }
                console.log('User saved successfully:', result);
            } catch (error) {
                console.error('Error saving request:', error);
                alert('Failed to save User');
            }
	}

	function updateChart(chart,data){
		const labels = data.current.map(item => item.date);
        const revenues = data.current.map(item => item.revenue);
        const previousRevenues = data.previous.map(item => item.revenue);
        chart.data.labels = labels;
        chart.data.datasets[0].data = revenues;
		chart.data.datasets[1].data = previousRevenues;
        chart.update();
	}
});
function generateRandomColor() {
	const r = Math.floor(Math.random() * 256); // Red (0-255)
	const g = Math.floor(Math.random() * 256); // Green (0-255)
	const b = Math.floor(Math.random() * 256); // Blue (0-255)
	return `rgba(${r}, ${g}, ${b}, 0.7)`; // Random color with transparency
}

function generateRandomBorderColor() {
	const r = Math.floor(Math.random() * 256); // Red (0-255)
	const g = Math.floor(Math.random() * 256); // Green (0-255)
	const b = Math.floor(Math.random() * 256); // Blue (0-255)
	return `rgba(${r}, ${g}, ${b}, 1)`; // Random solid color
}
</script>
