						<table>
							<tr>
								<td scope="col"><span class="titlehead"><button type="button" class="btn btn-light btn-sm" id="prev-week">&lt;</button></span></td>
								<td scope="col"><span class="titletext" id="week-display">&nbsp;<%=revenues.weekDisplay%>&nbsp;</span></td>
								<td scope="col"><span class="titlehead"><button type="button" class="btn btn-light btn-sm" id="next-week">&gt;</button></span></td>
							</tr>
							<tr><td scope="col" colspan="3"><canvas id="weeklyChart" width="300" height="200"></canvas></td></tr>
