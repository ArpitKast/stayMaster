<%- include("../layout/header",{ title: 'Banner Management'}) %>
<div class="propertylist">
    <div class="row">
        <div class="col-sm-6"><h1>Banner Management</h1></div>
        <div class="col-sm-6" style="text-align: right;">
            <a href="/admin/banner/add">
                <button type="button" class="greenbutton"> + Add Banner</button>
            </a>
            <button type="button" class="greenbutton ms-2" data-bs-toggle="modal" data-bs-target="#leadFormImageModal">Lead Popup Image</button>
        </div>
    </div>
    <%if(flash && flash != ''){%>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
             <%=flash%>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <%}%>
    <div class="propertylist_table mt-4">
        <table class="table">
            <thead>
                <tr>
                    <td scope="col">Image</td>
                    <td scope="col">Title</td>
                    <td scope="col">Description</td>
                    <td scope="col">Link</td>
                    <td scope="col">Order</td>
                    <td scope="col">Status</td>
                    <td scope="col">Actions</td>
                </tr>
            </thead>
            <tbody>
                <% if (banners && banners.length) { %>
                    <% banners.forEach((banner) => { %>
                        <tr>
                            <td scope="col">
                                <% if (banner.image_url) { %>
                                    <img src="<%= banner.image_url %>" alt="Banner" style="max-width: 150px; max-height: 80px; object-fit: cover;">
                                <% } else { %>
                                    <span class="text-muted">No image</span>
                                <% } %>
                            </td>
                            <td scope="col"><span class="text"><%= banner.title || '-' %></span></td>
                            <td scope="col"><span class="text"><%= banner.description ? (banner.description.length > 50 ? banner.description.substring(0, 50) + '...' : banner.description) : '-' %></span></td>
                            <td scope="col">
                                <% if (banner.link) { %>
                                    <a href="<%= banner.link %>" target="_blank"><%= banner.link.length > 30 ? banner.link.substring(0, 30) + '...' : banner.link %></a>
                                <% } else { %>
                                    <span class="text-muted">-</span>
                                <% } %>
                            </td>
                            <td scope="col"><span class="text"><%= banner.order || 0 %></span></td>
                            <td scope="col">
                                <% if (banner.active == 1) { %>
                                    <span class="badge bg-success">Active</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Inactive</span>
                                <% } %>
                            </td>
                            <td scope="col">
                                <a href="/admin/banner/edit/<%= banner.id %>" class="btn btn-sm btn-primary">Edit</a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="deleteBanner(<%= banner.id %>)">Delete</button>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7">No banners found.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include("leadFormModal", { leadFormImageUrl }) %>

<script>
async function deleteBanner(id) {
    if (!confirm('Are you sure you want to delete this banner?')) {
        return;
    }
    
    try {
        const formData = new FormData();
        const response = await fetch(`/admin/banner/delete/${id}`, {
            method: 'POST',
            body: formData
        });
        
        const result = await response.json();
        if(result.success){
            window.location.href = `/admin/banners/${result.flash}`;
        }else{
            alert('Error: ' + (result.error || 'Failed to delete banner'));
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Failed to delete banner');
    }
}
</script>

<%- include("../layout/footer") %>
