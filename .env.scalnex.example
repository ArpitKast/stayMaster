# Scalnex blog webhook — add to your .env / .env.live

# Required in production
SCALNEX_WEBHOOK_SECRET=your-shared-secret-from-scalnex

# User id from: node scripts/seed_scalnex_webhook_user.js
SCALNEX_WEBHOOK_AUTHOR_ID=

# Draft mode (0) until admin publishes in manager panel
BLOG_WEBHOOK_DEFAULT_ACTIVE=0

# Fallback category when Scalnex omits category
SCALNEX_WEBHOOK_DEFAULT_CATEGORY=Blog

# Webhook URL to register in Scalnex dashboard:
# https://thestaymaster.com/api/webhooks/scalnex/blog
# Header: x-webhook-secret: <SCALNEX_WEBHOOK_SECRET>
