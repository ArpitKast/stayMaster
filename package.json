{
  "name": "staymaster-backend",
  "version": "1.0.0",
  "description": "Staymaster Backend API",
  "main": "server.js",
  "scripts": {
    "api-test": "node scripts/api-test.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:live": "PORT=8085 node -r dotenv/config server.js dotenv_config_path=.env.live",
    "pm2:start": "PORT=8085 pm2 start npm --name staymaster-backend -- run start:live",
    "pm2:prod": "PORT=8085 pm2 start server.js --name tsm-backend --time",
    "pm2:ecosystem": "PORT=8085 pm2 start ecosystem.config.js --env production",
    "pm2:ecosystem_stop": "pm2 stop Staymaster && pm2 delete Staymaster",
    "pm2:stop": "pm2 stop staymaster-backend && pm2 delete staymaster-backend",
    "migrate": "node runallmigrations.js",
    "migrate:live": "node scripts/runMigration.js",
    "migrate:banners": "node scripts/runBannerMigration.js"
  },
  "author": "Vedika",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.0.2",
    "aws-sdk": "^2.1540.0",
    "axios": "^1.6.5",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.6.1",
    "form-data": "^4.0.4",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.17.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.17.1",
    "pm2": "^5.3.0",
    "redis": "^5.12.1",
    "request": "^2.88.2",
    "sharp": "^0.33.5",
    "stable": "^0.1.8",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.0.4",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
